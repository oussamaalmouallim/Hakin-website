{
  "P-02": {
    "source": "https://www.original-fit.ma/shop",
    "clone": "http://localhost:6011/boutique",
    "cibles": {
      "entete": { "source": "header", "clone": "[data-ref=entete]" },
      "titre": { "source": "h1", "clone": "[data-ref=boutique-titre]" },
      "bandeau-titre": { "source": "h1 ~ p, div.border-b > div > p", "clone": "[data-ref=boutique-titre] + p" },
      "filtres": { "source": "div.w-55 > aside", "clone": "div.w-\\[220px\\] > aside" },
      "titre-filtres": { "source": "div.w-55 aside h3", "clone": "div.w-\\[220px\\] aside h3" },
      "grille": { "source": "div.grid:has(> article)", "clone": "[data-ref=grille]" },
      "carte": { "source": "article", "clone": "[data-ref=grille] article" },
      "tri": { "source": "select", "clone": "select[aria-label=Trier]" },
      "pied": { "source": "footer", "clone": "[data-ref=pied]" }
    }
  }
}
