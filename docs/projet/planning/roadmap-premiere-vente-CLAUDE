  td{ padding:10px 10px 10px 0; border-bottom:1px solid var(--line); vertical-align:top; }
  tr:last-child td{ border-bottom:none; }
  .pill{ display:inline-block; font-size:11.5px; padding:2px 8px; border-radius:20px; background:var(--emerald-soft); color:var(--emerald); font-weight:600; white-space:nowrap; }
  .pill.brick{ background:var(--brick-soft); color:var(--brick); }
  .pill.brass{ background:#F3E9CB; color:#8A6710; }
  code.inline{ background:var(--paper-card); border:1px solid var(--line); border-radius:3px; padding:1px 6px; font-size:12.5px; }

  .day-flow{ margin:18px 0; }
  .day-step{ display:grid; grid-template-columns:64px 1fr; gap:16px; padding:16px 0; border-top:1px solid var(--line); }
  .day-step:first-child{ border-top:none; }
  .day-step .daytag{ font-family:'Fraunces', serif; font-size:14px; color:var(--brick); font-weight:600; padding-top:2px; }
  .day-step h4{ margin:0 0 6px 0; font-size:15.5px; font-weight:600; }
  .day-step p{ margin:0 0 6px 0; color:var(--ink-soft); font-size:14px; }
  .day-step ul{ margin:6px 0 0 0; padding-left:18px; color:var(--ink-soft); font-size:13.8px; }
  .day-step li{ margin-bottom:4px; }

  .hakim-tag{ display:inline-block; font-size:11px; font-weight:700; padding:2px 9px; border-radius:3px; background:#F3E9CB; color:#8A6710; margin-left:6px; }
  .you-tag{ display:inline-block; font-size:11px; font-weight:700; padding:2px 9px; border-radius:3px; background:var(--emerald-soft); color:var(--emerald); margin-left:6px; }

  .checklist{ list-style:none; padding:0; margin:16px 0; }
  .checklist li{ display:flex; gap:12px; padding:10px 0; border-top:1px solid var(--line); font-size:14.5px; color:var(--ink-soft); }
  .checklist li:first-child{ border-top:none; }
  .checklist .box{ width:18px; height:18px; border:2px solid var(--brick); border-radius:3px; flex-shrink:0; margin-top:1px; }

  .footnote{ margin-top:46px; padding-top:16px; border-top:1px solid var(--line); font-size:12.3px; color:var(--ink-soft); }

  @media (max-width: 860px){
    .layout{flex-direction:column;}
    nav.tabs{ width:100%; height:auto; position:sticky; top:0; z-index:10; display:flex; overflow-x:auto; padding:14px 10px; }
    nav.tabs .brand{ display:none; }
    nav.tabs button{ white-space:nowrap; border-left:none; border-bottom:3px solid transparent; padding:8px 14px; }
    nav.tabs button.active{ border-left:none; border-bottom:3px solid var(--brass); }
    main{ padding:30px 18px 90px 18px; }
    .day-step{ grid-template-columns:1fr; gap:6px; }
    h1.title{ font-size:26px; }
