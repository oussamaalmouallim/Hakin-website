  nav.tabs button:hover{ background:rgba(255,255,255,0.08); }
  nav.tabs button.active{ background:rgba(255,255,255,0.1); border-left:3px solid var(--brass); color:#fff; }
  nav.tabs button.active .num{ color:var(--brass); }

  main{ flex:1; max-width:950px; padding:56px 64px 120px 64px; }
  section{ display:none; }
  section.active{ display:block; }

  .kicker{ font-size:13px; color:var(--ink-soft); margin-bottom:6px; }
  h1.title{ font-size:34px; margin:0 0 14px 0; }
  p.lede{ font-size:16.5px; color:var(--ink-soft); max-width:64ch; margin-bottom:8px; }
  h2.sec-title{ font-size:26px; margin:0 0 6px 0; }
  .sec-sub{ color:var(--ink-soft); margin:0 0 26px 0; max-width:62ch; }
  .divider{ height:1px; background:var(--line); margin:36px 0; }

  .card{ background:var(--paper-card); border:1px solid var(--line); border-radius:3px; padding:20px 22px; margin-bottom:14px; }
  .card h3{ font-size:17px; margin:0 0 8px 0; }
  .card p{ margin:0; color:var(--ink-soft); font-size:14.5px; }
  .card ul{ margin:8px 0 0 0; padding-left:18px; color:var(--ink-soft); font-size:14px; }
  .card li{ margin-bottom:5px; }

  .warn{ border-left:4px solid var(--brick); }
  .warn h3{ color:var(--brick); }
