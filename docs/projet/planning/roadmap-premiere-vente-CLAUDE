<style>
  :root{
    --paper:#ECE6D8; --paper-card:#F7F2E6; --ink:#1E2430; --ink-soft:#565F70; --line:#D9D2BD;
    --emerald:#1F3F66; --emerald-soft:#DCE5EE; --brick:#2E4E70; --brick-soft:#DFE7EF; --brass:#B4881E; --white:#FFFDF7;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{ margin:0; background:var(--paper); color:var(--ink); font-family:'IBM Plex Sans', sans-serif; line-height:1.55; }
  h1,h2,h3,.display{ font-family:'Fraunces', serif; font-weight:600; letter-spacing:-0.01em; color:var(--ink); }
  code,.mono{ font-family:'IBM Plex Mono', monospace; }
  .layout{display:flex; min-height:100vh;}

  nav.tabs{ width:246px; flex-shrink:0; background:var(--brick); color:#E5EDF4; position:sticky; top:0; height:100vh; overflow-y:auto; padding:28px 0; }
  nav.tabs .brand{ padding:0 22px 22px 22px; border-bottom:1px solid rgba(255,255,255,0.18); margin-bottom:10px; }
  nav.tabs .brand .tag{ font-size:11px; letter-spacing:0.06em; color:#BED2E5; }
  nav.tabs .brand .name{ font-family:'Fraunces', serif; font-size:20px; font-weight:600; color:#fff; margin-top:4px; }
  nav.tabs button{ display:flex; gap:10px; align-items:baseline; width:100%; text-align:left; background:none; border:none; color:#DEE8F0; font-family:'IBM Plex Sans'; font-size:13.5px; padding:9px 22px; cursor:pointer; border-left:3px solid transparent; }
