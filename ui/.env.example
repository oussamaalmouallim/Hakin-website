# Copier en .env (non versionné) et remplir depuis Supabase → Connect / Project Settings → API.
# Uniquement l'URL et la clé publique (sb_publishable_… ou anon). Jamais la clé secrète ni service_role.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx

# Administration (lot 21) — SANS préfixe VITE_ : ces deux lignes restent sur votre ordinateur, jamais dans le site.
# Servent seulement à `npm run admin:sql`, qui donne le SQL à coller dans Supabase (la clé n'en sort qu'en empreinte).
ADMIN_EMAIL=
ADMIN_CLE=
