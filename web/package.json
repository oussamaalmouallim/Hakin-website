{
  "name": "hmode-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/sitemap.mjs && node --env-file-if-exists=.env scripts/pages-partage.mjs",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:admin": "playwright test -c playwright.admin.config.ts",
    "qualite:lighthouse": "node scripts/lighthouse.mjs",
    "images": "node scripts/optimiser-images.mjs",
    "logo": "node scripts/logo-marque.mjs",
    "admin:sql": "node --env-file=.env scripts/admin-sql.mjs",
    "test:supabase": "node --env-file=.env.supabase-local scripts/tests-supabase-local.mjs",
    "sante:sql": "node --env-file=.env scripts/sante-sql.mjs",
    "robot:sante": "node scripts/robot-sante.mjs",
    "sauvegarde": "node --env-file-if-exists=.env scripts/sauvegarde.mjs",
    "sauvegarde:tester": "node --env-file-if-exists=.env scripts/sauvegarde-tester.mjs",
    "guide:pdf": "node scripts/guide-pdf.mjs"
  },
  "dependencies": {
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.15.4",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "bcryptjs": "^2.4.3",
    "jsdom": "^25.0.1",
    "lighthouse": "^13.6.0",
    "pagedjs": "^0.4.3",
    "postcss": "^8.4.49",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
